# Copiar para /opt/orbix/api.env na droplet (chmod 600). Nunca commitar o arquivo real.
ENV=prod
# papel orbix_api (sem BYPASSRLS), transaction pooler
DATABASE_URL=postgresql://orbix_api.<ref>:<senha>@<pooler-host>:6543/postgres
DB_SSL=true
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

APP_URL=https://declare.orbixlab.com.br
API_URL=https://api-declare.orbixlab.com.br
CORS_ORIGINS=["https://declare.orbixlab.com.br"]
# 127.0.0.1: healthcheck interno do container
ALLOWED_HOSTS=["api-declare.orbixlab.com.br","127.0.0.1"]

# HMAC dos códigos de e-mail. Gerar uma vez: openssl rand -base64 48
SECRET_KEY=

# login por e-mail (Resend) e social. Vazio = forma de login desligada
RESEND_API_KEY=
EMAIL_FROM=Orbix Declare <no-reply@orbixlab.com.br>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# agente
OPENAI_API_KEY=
LLM_MODEL_AGENT=gpt-5.4

# relatórios no R2 (token restrito ao bucket)
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orbixdeclare

# só para conferir o memo na verificação pública
SOLANA_MEMO_RPC_URL=https://api.devnet.solana.com
SOLANA_MEMO_CLUSTER=devnet
# SOLANA_MEMO_SECRET_KEY e HELIUS_API_KEY NÃO entram aqui: só no worker.env
