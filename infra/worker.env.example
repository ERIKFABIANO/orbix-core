# Copiar para /opt/orbix/worker.env na droplet (chmod 600). Nunca commitar o arquivo real.
ENV=prod
# papel orbix_worker (grants mínimos, sem DELETE)
DATABASE_URL=postgresql://orbix_worker.<ref>:<senha>@<pooler-host>:6543/postgres
DB_SSL=true
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
SECRET_KEY=

# fontes de dados
HELIUS_API_KEY=
COINGECKO_API_KEY=

# gravação do hash na Solana: carteira DEDICADA, saldo máximo 0,05 SOL
SOLANA_MEMO_RPC_URL=https://api.devnet.solana.com
SOLANA_MEMO_CLUSTER=devnet
SOLANA_MEMO_SECRET_KEY=
