# Copiar para /opt/orbix/worker.env na droplet (chmod 600). Nunca commitar o arquivo real.
ENV=prod
DATABASE_URL=postgresql+asyncpg://orbix_api:<senha>@<pooler-host>:6543/postgres
DB_SSL=true
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
SUPABASE_URL=https://<ref>.supabase.co
HELIUS_API_KEY=
COINGECKO_API_KEY=
ANTHROPIC_API_KEY=
SOLANA_RPC_URL=
# carteira DEDICADA de memo, saldo máximo 0,05 SOL, devnet até 04/10
SOLANA_MEMO_SECRET_KEY=
