# Orbix Declare · Caddy atrás da Cloudflare (proxy laranja, SSL "Full (strict)")
# Certificado: Cloudflare Origin CA (gerado no painel da Cloudflare, válido só para a Cloudflare).
# Não precisa de token da Cloudflare no servidor.
{
	admin off
	servers {
		# IPs da Cloudflare (fonte: https://www.cloudflare.com/ips/). Atualizar com infra/cf-ips.ps1
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		# Authenticated Origin Pulls: só aceita conexões apresentando o certificado da Cloudflare.
		# Quem descobrir o IP da droplet e tentar acessar direto é recusado no TLS.
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}

	request_body {
		max_size 1MB
	}

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy api:8000 {
		header_up X-Forwarded-For {client_ip}
		transport http {
			read_timeout 60s
			write_timeout 60s
		}
	}

	log {
		output stdout
		# códigos de uso único do login e endereços de carteira não vão para o log
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
					delete address
				}
				request>headers>Authorization delete
			}
		}
	}
}

# qualquer outro Host em HTTP (acesso pelo IP, domínio estranho): fecha a conexão.
# Em 443 sem SNI conhecido o handshake TLS já falha, sem certificado para oferecer.
:80 {
	abort
}
