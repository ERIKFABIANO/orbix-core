# Copiar para .env (nunca commitar o .env). Valores reais no gerenciador de senhas do time.
ENV=dev

# ── Banco (Supabase) ──
# admin (postgres): só migrações, nunca na API
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# API: papel orbix_api (sem BYPASSRLS), transaction pooler
DATABASE_URL=postgresql://orbix_api.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# worker local: papel orbix_worker (grants mínimos, sem DELETE)
WORKER_DATABASE_URL=postgresql://orbix_worker.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_SSL=true

REDIS_URL=redis://localhost:6379/0

# ── Endereços públicos ──
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Sessão e códigos ──
# obrigatória em produção: openssl rand -base64 48
SECRET_KEY=

# ── Login por e-mail e social (vazio = desligado; em dev, o código de e-mail sai no log) ──
RESEND_API_KEY=
EMAIL_FROM=Orbix Declare <no-reply@orbixlab.com.br>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Dados on-chain e preços ──
HELIUS_API_KEY=
COINGECKO_API_KEY=

# ── Agente (OpenAI) ──
OPENAI_API_KEY=
LLM_MODEL_AGENT=gpt-5.4

# ── Cloudflare R2 (bucket privado) ──
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orbixdeclare

# ── Solana: gravação do hash (carteira DEDICADA; só o worker usa) ──
SOLANA_MEMO_RPC_URL=https://api.devnet.solana.com
SOLANA_MEMO_CLUSTER=devnet
SOLANA_MEMO_SECRET_KEY=

# ── Regras ──
# custo do que foi vendido sem aquisição conhecida: zero (regra da Receita) ou market
UNKNOWN_COST_POLICY=zero
