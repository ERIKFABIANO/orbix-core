# Copiar para .env (nunca commitar o .env). Valores reais no gerenciador de senhas do time.
ENV=dev

# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<ref>.supabase.co
# admin (postgres): só migrações e inspeção, nunca na API
SUPABASE_DB_PASSWORD=
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# API: papel orbix_api (sem BYPASSRLS), transaction pooler
DATABASE_URL=postgresql+asyncpg://orbix_api.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# worker local: papel orbix_worker (grants mínimos, sem DELETE)
WORKER_DATABASE_URL=postgresql+asyncpg://orbix_worker.<ref>:<senha>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_SSL=true

REDIS_URL=redis://localhost:6379/0

HELIUS_API_KEY=
COINGECKO_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 (bucket privado)
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orbix-declare-reports

SOLANA_RPC_URL=https://api.devnet.solana.com
# carteira DEDICADA de memo; só o worker usa
SOLANA_MEMO_SECRET_KEY=

CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
